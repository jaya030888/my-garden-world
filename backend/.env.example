# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL on Neon or local instance)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/floraquest"

# Security & Authentication
JWT_SECRET="super-secret-floraquest-jwt-key-32chars-minimum!"
COOKIE_SECRET="flora-cookie-secret-key-12345"

# CORS Client Origin (Production URL e.g. https://my-garden-world.vercel.app or local)
CLIENT_ORIGIN="http://localhost:5173"
