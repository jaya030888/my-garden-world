{
  "name": "my-garden-world-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:ai": "cd ai-service && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend run build",
    "build:all": "npm --prefix frontend run build && npm --prefix backend run build",
    "test": "npm --prefix frontend test && npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "npm --prefix backend test",
    "test:ai": "cd ai-service && pytest tests/ -v",
    "test:all": "npm --prefix frontend test && npm --prefix backend test",
    "prisma:migrate": "npm --prefix backend run prisma:migrate",
    "prisma:seed": "npm --prefix backend run prisma:seed"
  }
}
